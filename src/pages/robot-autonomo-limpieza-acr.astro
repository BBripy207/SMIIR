---
import { Image } from 'astro:assets';
import { ViewTransitions } from 'astro:transitions';
import HeaderApple from '../components/Header_clean.astro';
import Footer from '../components/Footer.astro';
import FloatingButtons from '../components/FloatingButtons.astro';
import ImageContainer from '../components/ImageContainer.astro';
import MainTitle from '../components/MainTitle.astro';
import PageLayout from '../components/PageLayout.astro';

// Metadatos SEO
const title = 'Robot autónomo para limpieza - ACR - SIMIR';
const description =
    'Presentación del robot autónomo para limpieza ACR - Tecnología avanzada de limpieza autónoma con navegación inteligente';
---

<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="robots" content="index, follow" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta
            property="og:url"
            content="https://smiir.com.mx/robot-autonomo-limpieza-acr"
        />

        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
        />
        <link rel="stylesheet" href="/styles/base.css" />
        <link rel="stylesheet" href="/styles/layout.css" />
        <link rel="stylesheet" href="/styles/typography.css" />
        <link rel="stylesheet" href="/styles/components.css" />
        <link rel="stylesheet" href="/styles/responsive.css" />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700;900&display=swap"
            rel="stylesheet"
        />

        <style>
            /* CSS moderno para iframes */
            .video-container iframe {
                border: none;
                border-radius: 12px;
                box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
                transition:
                    transform 0.3s ease,
                    box-shadow 0.3s ease;
            }

            .video-container iframe:hover {
                box-shadow: 0 12px 48px rgba(0, 0, 0, 0.15);
            }
        </style>

        <!-- View Transitions para navegación fluida -->
        <ViewTransitions />
    </head>

    <body>
        <HeaderApple />

        <PageLayout>
            <div class="content-text">
                <MainTitle
                    robotName="ROBOT AUTÓNOMO PARA LIMPIEZA"
                    version="ACR"
                />

                <ImageContainer
                    src="/assets/images/Robot autónomo para limpieza - ACR/Robot autónomo para limpieza - ACR .png"
                    alt="Robot autónomo para limpieza - ACR"
                />

                <ImageContainer
                    src="/assets/images/Robot autónomo para limpieza - ACR/Robot autónomo para limpieza - ACR1.png"
                    alt="Robot autónomo para limpieza - ACR"
                />

                <h2 class="interaction-title">Side View</h2>

                <ImageContainer
                    src="/assets/images/Robot autónomo para limpieza - ACR/acr (4).png"
                    alt="Robot ACR - Side View"
                />

                <h2 class="interaction-title">
                    Estaciones de Soporte y Autonomía del Robot
                </h2>

                <ImageContainer
                    src="/assets/images/Robot autónomo para limpieza - ACR/acr (3).png"
                    alt="Robot ACR - Componentes"
                />

                <h2 class="interaction-title">
                    Componentes de Mantenimiento y Acceso del Robot
                </h2>

                <ImageContainer
                    src="/assets/images/Robot autónomo para limpieza - ACR/acr (2).png"
                    alt="Robot ACR - Componentes de Mantenimiento"
                />

                <h2 class="interaction-title">
                    Plataforma de Control, Navegación y Monitoreo Remoto del
                    Robot
                </h2>

                <ImageContainer
                    src="/assets/images/Robot autónomo para limpieza - ACR/acr (5).png"
                    alt="Robot ACR - Plataforma de Control y Monitoreo"
                />

                <h2 class="interaction-title">Características y eficiencia</h2>

                <ImageContainer
                    src="/assets/images/Robot autónomo para limpieza - ACR/Robot autónomo para limpieza - ACR4.png"
                    alt="Robot autónomo para limpieza - ACR"
                />

                <h2 class="interaction-title">Operación en la vida real</h2>

                <ImageContainer
                    src="/assets/images/Robot autónomo para limpieza - ACR/Robot autónomo para limpieza - ACR5.png"
                    alt="Robot autónomo para limpieza - ACR"
                />

                <ImageContainer
                    src="/assets/images/Robot autónomo para limpieza - ACR/Robot autónomo para limpieza - ACR6.png"
                    alt="Robot autónomo para limpieza - ACR"
                />
            </div>
        </PageLayout>

        <Footer />

        <!-- Scripts modulares -->
        <script src="/components/SlideshowManager.js" is:inline></script>
        <script src="/components/NavigationManager.js" is:inline></script>
        <script src="/components/AnimationManager.js" is:inline></script>
        <script src="/components/app.js" is:inline></script>

        <FloatingButtons />
    </body>
</html>
